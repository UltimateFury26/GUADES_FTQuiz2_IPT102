@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_ReportsViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Port of Admin/Reports.aspx (Site.Master shell comes from _ViewStart; the
    // controller sets the FTQuiz2_admin body class). Charts are pure CSS: each .bar-fill gets an inline
    // height computed in the view model. The split bar widths are inline too, like the source Style["width"].
    ViewBag.Title = "Reports";
}

<div class="admin-head">
    <div>
        <h1 class="admin-title">Reports</h1>
        <p class="admin-sub">Live statistics about registered accounts and the website's content.</p>
    </div>
</div>

@if (!Model.Loaded)
{
    <div class="alert alert-error" role="alert">@Model.Message</div>
}
else
{
    <!-- SUMMARY CARDS -->
    <div class="stat-grid">
        <div class="stat-card">
            <p class="stat-value">@FTQuiz2_ReportsViewModel.Number(Model.Summary.TotalUsers)</p>
            <p class="stat-label">Total users</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">@FTQuiz2_ReportsViewModel.Number(Model.Summary.ActiveUsers)</p>
            <p class="stat-label">Active</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">@FTQuiz2_ReportsViewModel.Number(Model.Summary.InactiveUsers)</p>
            <p class="stat-label">Inactive</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">@FTQuiz2_ReportsViewModel.Number(Model.Summary.AdminUsers)</p>
            <p class="stat-label">Admins</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">@FTQuiz2_ReportsViewModel.Number(Model.Summary.NewThisMonth)</p>
            <p class="stat-label">New this month</p>
        </div>
    </div>

    <div class="report-grid">

        <!-- SIGNUPS PER MONTH (pure CSS bars) -->
        <section class="report-card" aria-labelledby="signupsHeading">
            <h2 id="signupsHeading" class="report-title">Signups per month</h2>
            <p class="report-sub">@Model.SignupTotalText</p>

            <div class="bar-chart">
                @foreach (FTQuiz2_ReportBar bar in Model.Signups)
                {
                    <div class="bar-col" title="@bar.Tooltip">
                        <span class="bar-value">@bar.Value</span>
                        <div class="bar-track">
                            <div class="bar-fill" style="height: @(bar.HeightPercent)%"></div>
                        </div>
                        <span class="bar-label">@bar.Month<br />@bar.Year</span>
                    </div>
                }
            </div>
        </section>

        <!-- ACTIVE VS INACTIVE -->
        <section class="report-card" aria-labelledby="statusHeading">
            <h2 id="statusHeading" class="report-title">Active vs. inactive</h2>
            <p class="report-sub">Share of all registered accounts.</p>

            <div class="split-bar" role="img" aria-label="Active versus inactive accounts">
                <div class="split-active" style="width: @(Model.ActivePercent)%" title="@Model.ActiveTooltip"></div>
                <div class="split-inactive" style="width: @(Model.InactivePercent)%" title="@Model.InactiveTooltip"></div>
            </div>

            <ul class="split-legend">
                <li><span class="legend-dot legend-active"></span>Active <strong>@Model.ActiveLegend</strong></li>
                <li><span class="legend-dot legend-inactive"></span>Inactive <strong>@Model.InactiveLegend</strong></li>
            </ul>
        </section>

    </div>

    <!-- USER VISITS (Users only; the Admin's own visits are never counted) -->
    <h2 class="report-heading">Portfolio visits</h2>
    <p class="report-sub">@Model.VisitNote</p>

    <div class="stat-grid">
        <div class="stat-card">
            <p class="stat-value">@FTQuiz2_ReportsViewModel.Number(Model.VisitSummary.TotalVisits)</p>
            <p class="stat-label">Total visits</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">@FTQuiz2_ReportsViewModel.Number(Model.VisitSummary.UniqueVisitors)</p>
            <p class="stat-label">Unique visitors</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">@FTQuiz2_ReportsViewModel.Number(Model.VisitSummary.VisitsToday)</p>
            <p class="stat-label">Today</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">@FTQuiz2_ReportsViewModel.Number(Model.VisitSummary.VisitsThisMonth)</p>
            <p class="stat-label">This month</p>
        </div>
    </div>

    <section class="report-card" aria-labelledby="visitsHeading">
        <h2 id="visitsHeading" class="report-title">Visits per month</h2>
        <p class="report-sub">@Model.VisitsTotalText</p>

        <div class="bar-chart">
            @foreach (FTQuiz2_ReportBar bar in Model.Visits)
            {
                <div class="bar-col" title="@bar.Tooltip">
                    <span class="bar-value">@bar.Value</span>
                    <div class="bar-track">
                        <div class="bar-fill" style="height: @(bar.HeightPercent)%"></div>
                    </div>
                    <span class="bar-label">@bar.Month<br />@bar.Year</span>
                </div>
            }
        </div>
    </section>

    <!-- LATEST SIGNUPS -->
    <h2 class="report-heading">Latest signups</h2>
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Username</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Status</th>
                    <th scope="col">Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Recent)
                {
                    <tr>
                        <td class="cell-strong">@user.Username</td>
                        <td class="cell-wrap">@user.Email</td>
                        <td><span class="@Model.RoleBadgeClass(user.Role)">@user.Role</span></td>
                        <td><span class="@Model.StatusBadgeClass(user.Status)">@user.Status</span></td>
                        <td>@Model.FormatDate(user.CreatedAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- CONTENT SUMMARY -->
    <h2 class="report-heading">Website content</h2>
    <div class="table-scroll">
        <table class="data-table data-table-compact">
            <thead>
                <tr>
                    <th scope="col">Section</th>
                    <th scope="col">Items</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Content)
                {
                    <tr>
                        <td class="cell-strong">@item.Section</td>
                        <td>@item.Items</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
