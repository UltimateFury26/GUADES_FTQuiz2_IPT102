@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_MyAccountViewModel
@{
    // Port of MyAccount.aspx (Site.Master shell comes from _ViewStart). Two forms, two cards.
    // The new-password input keeps id "txtNewPassword" because the strength meter looks it up
    // through data-strength-for. The body.FTQuiz2_account class is set by the controller (D-17).
    ViewBag.Title = "My Account";
    string focusId = ViewBag.FTQuiz2_FocusId as string;
    string accountMessage = ViewBag.FTQuiz2_AccountMessage as string;
    string accountKind = (ViewBag.FTQuiz2_AccountMessageKind as string) ?? "error";
    string passwordMessage = ViewBag.FTQuiz2_PasswordMessage as string;
    string passwordKind = (ViewBag.FTQuiz2_PasswordMessageKind as string) ?? "error";
}

<h1 class="settings-title">My Account</h1>

<div class="settings-grid">

    <!-- ACCOUNT INFORMATION -->
    <div class="settings-card">
        <h2>Account Information</h2>

        @if (!string.IsNullOrWhiteSpace(accountMessage))
        {
            <div class="@("alert alert-" + accountKind)" role="alert">@accountMessage</div>
        }

        @using (Html.BeginForm("SaveAccount", "FTQuiz2_MyAccount", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-field">
                <span class="form-label">Username</span>
                <span class="readonly-field">@Model.Username</span>
            </div>

            <div class="form-field">
                <label class="form-label" for="Email">Email</label>
                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-input",
                    type = "email",
                    maxlength = "100",
                    autocomplete = "email",
                    autocapitalize = "none",
                    spellcheck = "false",
                    data_rule_email = "false"   /* keep the source's own message, not jquery.validate's generic email one */
                })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "form-error" })
            </div>

            <div class="form-field">
                <label class="form-label" for="Phone">Phone number</label>
                @Html.TextBoxFor(m => m.Phone, new
                {
                    @class = "form-input",
                    type = "tel",
                    maxlength = "11",
                    autocomplete = "tel",
                    inputmode = "numeric",
                    placeholder = "09123456789"
                })
                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "form-error" })
            </div>

            <button type="submit" class="pill-btn pill-btn-primary settings-submit">Save changes</button>
        }
    </div>

    <!-- CHANGE PASSWORD -->
    <div class="settings-card">
        <h2>Change Password</h2>

        @if (!string.IsNullOrWhiteSpace(passwordMessage))
        {
            <div class="@("alert alert-" + passwordKind)" role="alert">@passwordMessage</div>
        }

        @using (Html.BeginForm("ChangePassword", "FTQuiz2_MyAccount", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-field">
                <label class="form-label" for="CurrentPassword">Current password</label>
                <div class="password-field">
                    @Html.PasswordFor(m => m.CurrentPassword, new
                    {
                        @class = "form-input",
                        maxlength = "100",
                        autocomplete = "current-password"
                    })
                    <button type="button" class="password-toggle" aria-label="Show password">
                        <svg class="icon icon-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                        <svg class="icon icon-eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18" /><path d="M10.6 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C4 8.3 2 12 2 12s3.6 7 10 7c1.4 0 2.7-.3 3.9-.8" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "form-error" })
            </div>

            <div class="form-field">
                <label class="form-label" for="txtNewPassword">New password</label>
                <div class="password-field">
                    @Html.PasswordFor(m => m.NewPassword, new
                    {
                        id = "txtNewPassword",              /* pinned: strength meter target */
                        @class = "form-input",
                        maxlength = "100",
                        autocomplete = "new-password"
                    })
                    <button type="button" class="password-toggle" aria-label="Show password">
                        <svg class="icon icon-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                        <svg class="icon icon-eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18" /><path d="M10.6 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C4 8.3 2 12 2 12s3.6 7 10 7c1.4 0 2.7-.3 3.9-.8" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
                    </button>
                </div>
                <div class="pwd-strength" data-strength-for="txtNewPassword">
                    <div class="pwd-strength-track"><div class="pwd-strength-fill" data-strength-fill></div></div>
                    <span class="pwd-strength-label" data-strength-label></span>
                </div>
                <p class="form-hint">At least 8 characters, with a letter and a number.</p>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "form-error" })
            </div>

            <div class="form-field">
                <label class="form-label" for="ConfirmNewPassword">Confirm new password</label>
                <div class="password-field">
                    @Html.PasswordFor(m => m.ConfirmNewPassword, new
                    {
                        @class = "form-input",
                        maxlength = "100",
                        autocomplete = "new-password"
                    })
                    <button type="button" class="password-toggle" aria-label="Show password">
                        <svg class="icon icon-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                        <svg class="icon icon-eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18" /><path d="M10.6 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C4 8.3 2 12 2 12s3.6 7 10 7c1.4 0 2.7-.3 3.9-.8" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "form-error" })
            </div>

            <button type="submit" class="pill-btn pill-btn-primary settings-submit">Change password</button>
        }
    </div>

</div>

@section FTQuiz2_Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @if (!string.IsNullOrEmpty(focusId))
    {
        <script>
            (function () {
                var el = document.getElementById("@focusId");
                if (el) { el.focus(); }
            })();
        </script>
    }
}
