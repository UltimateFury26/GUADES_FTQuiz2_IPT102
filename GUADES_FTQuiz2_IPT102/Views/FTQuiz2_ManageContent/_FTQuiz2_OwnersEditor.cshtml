@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_OwnersEditorViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Owners Information: the records shown on the Owners / Company page.
    string listUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "owners" });
    string addUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "owners", add = "1" });
}

<div class="editor-head">
    <div>
        <h2 class="editor-title">Owners Information</h2>
        <p class="editor-intro">The owners or company representatives shown on the Owners / Company page. Use only verified information; a record in [brackets] is shown as a placeholder.</p>
    </div>
    @if (!Model.ShowForm)
    {
        <a class="pill-btn pill-btn-primary" href="@addUrl">Add owner</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="@(Model.MessageKind == "success" ? "alert alert-success" : "alert alert-error")" role="alert">@Model.Message</div>
}

@if (Model.ShowForm)
{
    <!-- ADD / EDIT FORM -->
    using (Html.BeginForm("SaveOwner", "FTQuiz2_ManageContent", FormMethod.Post,
        new { @class = "editor-card editor-form", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.OwnerId)
        <h2>@(Model.IsEdit ? "Edit owner" : "Add an owner")</h2>

        <div class="form-row">
            <div class="form-field">
                <label class="form-label" for="FullName">Full name</label>
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-input", maxlength = 100 })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "form-error" })
            </div>

            <div class="form-field">
                <label class="form-label" for="Position">Position (optional)</label>
                @Html.TextBoxFor(m => m.Position, new { @class = "form-input", maxlength = 100 })
                @Html.ValidationMessageFor(m => m.Position, "", new { @class = "form-error" })
            </div>
        </div>

        <div class="form-field">
            <label class="form-label" for="Bio">Details (optional)</label>
            @Html.TextAreaFor(m => m.Bio, 4, 20, new { @class = "form-input form-textarea", maxlength = 1000 })
            @Html.ValidationMessageFor(m => m.Bio, "", new { @class = "form-error" })
            <p class="form-hint">Up to 1000 characters.</p>
        </div>

        <div class="form-field">
            <label class="form-label" for="Email">Email (optional)</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-input", maxlength = 100, type = "email", autocapitalize = "none", spellcheck = "false" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "form-error" })
        </div>

        <div class="form-field">
            <span class="form-label">Photo (optional)</span>
            <div class="avatar-edit">
                @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
                {
                    <div><img class="photo-preview" src="@Model.CurrentPhotoUrl" alt="Current photo" /></div>
                }
                <div class="avatar-controls">
                    <input type="file" name="photo" class="form-file" accept=".jpg,.jpeg,.png,.gif" />
                    <p class="form-hint">@Model.PhotoHint</p>
                </div>
            </div>
        </div>

        <div class="form-field form-field-narrow">
            <label class="form-label" for="SortOrder">Display order (optional)</label>
            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-input", maxlength = 4, inputmode = "numeric" })
            @Html.ValidationMessageFor(m => m.SortOrder, "", new { @class = "form-error" })
            <p class="form-hint">Lower numbers come first. Empty puts a new owner last, or keeps the current position when editing.</p>
        </div>

        <div class="editor-actions">
            <button type="submit" class="pill-btn pill-btn-primary">Save owner</button>
            <a class="pill-btn pill-btn-secondary" href="@listUrl">Cancel</a>
        </div>
    }
}
else if (!Model.LoadFailed && Model.Items.Count > 0)
{
    <!-- LIST -->
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Photo</th>
                    <th scope="col">Name</th>
                    <th scope="col">Details</th>
                    <th scope="col">Order</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    string thumb = FTQuiz2_ContentFormat.ThumbUrl(item.PhotoPath);
                    bool placeholder = FTQuiz2_BusinessFormat.IsPlaceholder(item.FullName) || FTQuiz2_BusinessFormat.IsPlaceholder(item.Bio);
                    <tr>
                        <td>
                            @if (thumb.Length == 0) { <span class="thumb thumb-empty"></span> }
                            else { <img class="thumb" src="@thumb" alt="" /> }
                        </td>
                        <td class="cell-strong cell-wrap">
                            @item.FullName
                            @if (placeholder) { <span class="badge badge-user">Needs completion</span> }
                            <p class="post-meta">@FTQuiz2_ContentFormat.OrDash(item.Position)</p>
                        </td>
                        <td class="cell-wrap">@FTQuiz2_ContentFormat.Preview(item.Bio, 80)</td>
                        <td>@item.SortOrder</td>
                        <td class="cell-actions">
                            @using (Html.BeginForm("Index", "FTQuiz2_ManageContent", FormMethod.Get, new { @class = "inline-form" }))
                            {
                                <input type="hidden" name="tab" value="owners" />
                                <input type="hidden" name="edit" value="@item.OwnerId" />
                                <button type="submit" class="row-btn">Edit</button>
                            }
                            @using (Html.BeginForm("DeleteOwner", "FTQuiz2_ManageContent", FormMethod.Post, new { @class = "inline-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.OwnerId" />
                                <button type="submit" class="row-btn row-btn-danger"
                                        data-confirm="@("Delete " + item.FullName + "? This can't be undone.")"
                                        onclick="return confirm(this.getAttribute('data-confirm'));">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!Model.LoadFailed)
{
    <!-- EMPTY STATE -->
    <div class="empty-state">
        <p class="empty-title">No owner records yet</p>
        <p class="empty-text">Click &ldquo;Add owner&rdquo; to create the first one. The Owners / Company page needs at least one record.</p>
    </div>
}
