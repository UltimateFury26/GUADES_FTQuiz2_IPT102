@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_ContentPageViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_Security
@{
    // Manage Business Content (profile, contact, owners, brand media). The controller fills only
    // the active editor's view model and this page renders the matching partial. Products are managed on
    // their own page (Admin > Products).
    ViewBag.Title = "Manage Content";
}

@Html.Partial("_FTQuiz2_AdminNav")

<div class="admin-head content-admin-head">
    <div>
        <h1 class="admin-title">Manage Content</h1>
        <p class="admin-sub">The Mogu Mogu business information. Signed-in users see exactly what you save here. Products have their own page under Admin &rsaquo; Products.</p>
    </div>
    <div class="admin-head-actions">
        <a class="pill-btn pill-btn-secondary" href="@Url.Content("~/FTQuiz2_Admin/FTQuiz2_ManageProducts")">Manage products</a>
    </div>
</div>

<nav class="tab-bar content-tab-bar" aria-label="Content sections">
    @foreach (var tab in Model.Tabs)
    {
        <a class="@("tab-link" + (tab.Key == Model.ActiveTab ? " active" : ""))"
           href="@Url.Action("Index", "FTQuiz2_ManageContent", new { tab = tab.Key })">@tab.Title</a>
    }
</nav>

@if (Model.ActiveTab == FTQuiz2_Constants.ContentTabs.Contact)
{
    @Html.Partial("_FTQuiz2_ContactEditor", Model.Contact)
}
else if (Model.ActiveTab == FTQuiz2_Constants.ContentTabs.Owners)
{
    @Html.Partial("_FTQuiz2_OwnersEditor", Model.Owners)
}
else if (Model.ActiveTab == FTQuiz2_Constants.ContentTabs.Media)
{
    @Html.Partial("_FTQuiz2_BrandMediaEditor", Model.Media)
}
else
{
    @Html.Partial("_FTQuiz2_BusinessProfileEditor", Model.Business)
}

@section FTQuiz2_Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
