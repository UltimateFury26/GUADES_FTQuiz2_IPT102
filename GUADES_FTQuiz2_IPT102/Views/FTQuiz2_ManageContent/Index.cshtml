@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_ContentPageViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_Security
@{
    // Port of Admin/ManageContent.aspx (Site.Master shell comes from _ViewStart; the controller sets the
    // FTQuiz2_admin body class). The source loaded one editor user control per ?tab=; here the controller
    // fills only the active editor's view model and this page renders the matching partial.
    ViewBag.Title = "Manage Content";
}

<div class="admin-head">
    <div>
        <h1 class="admin-title">Manage Content</h1>
        <p class="admin-sub">The website's own content. Signed-in users see exactly what you save here.</p>
    </div>
</div>

<nav class="tab-bar" aria-label="Content sections">
    @foreach (var tab in Model.Tabs)
    {
        <a class="@("tab-link" + (tab.Key == Model.ActiveTab ? " active" : ""))"
           href="@Url.Action("Index", "FTQuiz2_ManageContent", new { tab = tab.Key })">@tab.Title</a>
    }
</nav>

@if (Model.ActiveTab == FTQuiz2_Constants.ContentTabs.Education)
{
    @Html.Partial("_FTQuiz2_EducationEditor", Model.Education)
}
else if (Model.ActiveTab == FTQuiz2_Constants.ContentTabs.Skills)
{
    @Html.Partial("_FTQuiz2_SkillsEditor", Model.Skills)
}
else if (Model.ActiveTab == FTQuiz2_Constants.ContentTabs.Hobbies)
{
    @Html.Partial("_FTQuiz2_HobbiesEditor", Model.Hobbies)
}
else if (Model.ActiveTab == FTQuiz2_Constants.ContentTabs.Projects)
{
    @Html.Partial("_FTQuiz2_ProjectsEditor", Model.Projects)
}
else if (Model.ActiveTab == FTQuiz2_Constants.ContentTabs.Gallery)
{
    @Html.Partial("_FTQuiz2_GalleryEditor", Model.Gallery)
}
else
{
    @Html.Partial("_FTQuiz2_PersonalInfoEditor", Model.Personal)
}

@section FTQuiz2_Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
