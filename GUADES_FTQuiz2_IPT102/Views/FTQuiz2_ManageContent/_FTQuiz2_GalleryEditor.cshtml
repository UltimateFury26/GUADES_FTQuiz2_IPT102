@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_GalleryEditorViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Port of Admin/Controls/GalleryEditor.ascx. Adding needs a photo; editing may keep the current one.
    string listUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "gallery" });
    string addUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "gallery", add = "1" });
}

<div class="editor-head">
    <div>
        <h2 class="editor-title">Gallery</h2>
        <p class="editor-intro">The photos shown on the Gallery board of Home. Each one needs a photo; the caption is optional.</p>
    </div>
    @if (!Model.ShowForm)
    {
        <a class="pill-btn pill-btn-primary" href="@addUrl">Add photo</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="@(Model.MessageKind == "success" ? "alert alert-success" : "alert alert-error")" role="alert">@Model.Message</div>
}

@if (Model.ShowForm)
{
    <!-- ADD / EDIT FORM -->
    using (Html.BeginForm("SaveGalleryItem", "FTQuiz2_ManageContent", FormMethod.Post,
        new { @class = "editor-card editor-form", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.GalleryId)
        <h2>@(Model.IsEdit ? "Edit photo" : "Add a photo")</h2>

        <div class="form-field">
            <span class="form-label">Photo</span>
            <div class="avatar-edit">
                @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
                {
                    <div><img class="photo-preview" src="@Model.CurrentPhotoUrl" alt="Current photo" /></div>
                }
                <div class="avatar-controls">
                    <input type="file" name="photo" class="form-file" accept=".jpg,.jpeg,.png,.gif" />
                    <p class="form-hint">@Model.PhotoHint</p>
                </div>
            </div>
        </div>

        <div class="form-field">
            <label class="form-label" for="Caption">Caption (optional)</label>
            @Html.TextBoxFor(m => m.Caption, new { @class = "form-input", maxlength = 200 })
            <p class="form-hint">A short line, up to 200 characters. It is used as the photo's description for screen readers.</p>
        </div>

        <div class="form-field form-field-narrow">
            <label class="form-label" for="SortOrder">Display order (optional)</label>
            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-input", maxlength = 4, inputmode = "numeric" })
            @Html.ValidationMessageFor(m => m.SortOrder, "", new { @class = "form-error" })
            <p class="form-hint">Lower numbers come first. Empty puts a new photo last, or keeps the current position when editing. The first three photos also appear on the Gallery tile.</p>
        </div>

        <div class="editor-actions">
            <button type="submit" class="pill-btn pill-btn-primary">Save photo</button>
            <a class="pill-btn pill-btn-secondary" href="@listUrl">Cancel</a>
        </div>
    }
}
else if (!Model.LoadFailed && Model.Items.Count > 0)
{
    <!-- LIST -->
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Photo</th>
                    <th scope="col">Caption</th>
                    <th scope="col">Order</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    string thumb = FTQuiz2_ContentFormat.ThumbUrl(item.ImagePath);
                    <tr>
                        <td>
                            @if (thumb.Length == 0) { <span class="thumb thumb-empty"></span> }
                            else { <img class="thumb" src="@thumb" alt="" /> }
                        </td>
                        <td class="cell-wrap">@FTQuiz2_ContentFormat.OrDash(item.Caption)</td>
                        <td>@item.SortOrder</td>
                        <td class="cell-actions">
                            @using (Html.BeginForm("Index", "FTQuiz2_ManageContent", FormMethod.Get, new { @class = "inline-form" }))
                            {
                                <input type="hidden" name="tab" value="gallery" />
                                <input type="hidden" name="edit" value="@item.GalleryId" />
                                <button type="submit" class="row-btn">Edit</button>
                            }
                            @using (Html.BeginForm("DeleteGalleryItem", "FTQuiz2_ManageContent", FormMethod.Post, new { @class = "inline-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.GalleryId" />
                                <button type="submit" class="row-btn row-btn-danger"
                                        data-confirm="Delete this photo? This can't be undone."
                                        onclick="return confirm(this.getAttribute('data-confirm'));">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!Model.LoadFailed)
{
    <!-- EMPTY STATE -->
    <div class="empty-state">
        <p class="empty-title">No photos yet</p>
        <p class="empty-text">Click &ldquo;Add photo&rdquo; to upload the first one. Until you do, the Gallery board is hidden on Home.</p>
    </div>
}
