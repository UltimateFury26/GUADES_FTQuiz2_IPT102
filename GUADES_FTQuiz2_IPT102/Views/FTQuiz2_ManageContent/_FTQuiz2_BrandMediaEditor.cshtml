@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_BrandMediaEditorViewModel

@* Brand Media: homepage hero and About page imagery. Empty file inputs keep the current images. *@
@using (Html.BeginForm("SaveBrandMedia", "FTQuiz2_ManageContent", FormMethod.Post,
    new { @class = "editor-card brand-media-editor", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <header class="brand-media-editor-head">
        <div>
            <h2>Brand Media</h2>
            <p class="editor-intro">Manage the large images used to introduce Mogu Mogu. Choose clear, high-quality images that are permitted for use by your business.</p>
        </div>
    </header>

    <div class="brand-media-guidance" role="note">
        <strong>Before you upload</strong>
        <span>Accepted formats: JPG, PNG, or GIF. Maximum file size: 5 MB per image. You can replace either image independently; leaving a file field empty keeps its current image.</span>
    </div>

    if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="@(Model.MessageKind == "success" ? "alert alert-success" : "alert alert-error")" role="alert" aria-live="polite">@Model.Message</div>
    }

    <div class="brand-media-grid">
        <section class="brand-media-panel" aria-labelledby="brand-media-hero-title">
            <div class="brand-media-panel-heading">
                <span class="brand-media-index">01</span>
                <div>
                    <h3 id="brand-media-hero-title">Homepage hero image</h3>
                    <p>The main visual shown in the homepage introduction.</p>
                </div>
            </div>

            <div class="brand-media-preview-wrap">
                <div class="brand-media-preview brand-media-preview-hero">
                    @if (!string.IsNullOrEmpty(Model.HeroUrl))
                    {
                        <img src="@Model.HeroUrl" alt="Current homepage hero image" />
                        <span class="brand-media-preview-label">CURRENT IMAGE</span>
                    }
                    else
                    {
                        <div class="brand-media-empty" aria-label="No homepage hero image is currently set">
                            <span aria-hidden="true"><svg data-mg-icon viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="2"/></svg></span>
                            <strong>No image set</strong>
                            <small>Upload an image to add a homepage hero visual</small>
                        </div>
                    }
                </div>
            </div>

            <div class="brand-media-upload-field">
                <label class="form-label" for="brand-media-hero-file">Choose replacement image</label>
                <input id="brand-media-hero-file" type="file" name="heroImage" class="form-file brand-media-file" accept=".jpg,.jpeg,.png,.gif" />
                <p class="form-hint">JPG, PNG, or GIF · Up to 5 MB</p>
            </div>
        </section>

        <section class="brand-media-panel" aria-labelledby="brand-media-about-title">
            <div class="brand-media-panel-heading">
                <span class="brand-media-index">02</span>
                <div>
                    <h3 id="brand-media-about-title">Our Story image</h3>
                    <p>The supporting visual displayed on the About page.</p>
                </div>
            </div>

            <div class="brand-media-preview-wrap">
                <div class="brand-media-preview brand-media-preview-about">
                    @if (!string.IsNullOrEmpty(Model.AboutUrl))
                    {
                        <img src="@Model.AboutUrl" alt="Current About page image" />
                        <span class="brand-media-preview-label">CURRENT IMAGE</span>
                    }
                    else
                    {
                        <div class="brand-media-empty" aria-label="No separate About image is currently set">
                            <span aria-hidden="true"><svg data-mg-icon viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="2"/></svg></span>
                            <strong>Using homepage image</strong>
                            <small>Upload a separate image to customize the About page</small>
                        </div>
                    }
                </div>
            </div>

            <div class="brand-media-upload-field">
                <label class="form-label" for="brand-media-about-file">Choose replacement image</label>
                <input id="brand-media-about-file" type="file" name="aboutImage" class="form-file brand-media-file" accept=".jpg,.jpeg,.png,.gif" />
                <p class="form-hint">JPG, PNG, or GIF · Up to 5 MB</p>
            </div>
        </section>
    </div>

    <footer class="brand-media-editor-footer">
        <p>Only the images you select will be replaced. Existing images remain in place when their file fields are left empty.</p>
        <button type="submit" class="pill-btn pill-btn-primary settings-submit">Save brand images</button>
    </footer>
}
