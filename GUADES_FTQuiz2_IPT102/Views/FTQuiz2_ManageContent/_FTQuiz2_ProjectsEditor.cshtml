@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_ProjectsEditorViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_Helpers
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Port of Admin/Controls/ProjectsEditor.ascx. Projects have no photo, so there is no upload.
    string listUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "projects" });
    string addUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "projects", add = "1" });
}

<div class="editor-head">
    <div>
        <h2 class="editor-title">Recent Projects</h2>
        <p class="editor-intro">The pins shown on the Recent Projects board of Home. Empty optional fields are hidden there.</p>
    </div>
    @if (!Model.ShowForm)
    {
        <a class="pill-btn pill-btn-primary" href="@addUrl">Add project</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="@(Model.MessageKind == "success" ? "alert alert-success" : "alert alert-error")" role="alert">@Model.Message</div>
}

@if (Model.ShowForm)
{
    <!-- ADD / EDIT FORM -->
    using (Html.BeginForm("SaveProject", "FTQuiz2_ManageContent", FormMethod.Post, new { @class = "editor-card editor-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ProjectId)
        <h2>@(Model.IsEdit ? "Edit project" : "Add a project")</h2>

        <div class="form-field">
            <label class="form-label" for="Title">Project title</label>
            @Html.TextBoxFor(m => m.Title, new { @class = "form-input", maxlength = 150 })
            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "form-error" })
        </div>

        <div class="form-row">
            <div class="form-field">
                <label class="form-label" for="TechStack">Tech stack (optional)</label>
                @Html.TextBoxFor(m => m.TechStack, new { @class = "form-input", maxlength = 250, placeholder = "ASP.NET Web Forms, C#, SQL Server" })
            </div>

            <div class="form-field">
                <label class="form-label" for="Role">My role (optional)</label>
                @Html.TextBoxFor(m => m.Role, new { @class = "form-input", maxlength = 100 })
            </div>
        </div>

        <div class="form-field">
            <label class="form-label" for="Details">Details (optional)</label>
            @Html.TextAreaFor(m => m.Details, 5, 20, new { @class = "form-input form-textarea", maxlength = 2000 })
            <p class="form-hint">What the project is and what you built, up to 2000 characters.</p>
        </div>

        <div class="form-field">
            <label class="form-label" for="RepoUrl">Repository link (optional)</label>
            @Html.TextBoxFor(m => m.RepoUrl, new { @class = "form-input", maxlength = 250, type = "url", placeholder = "https://github.com/username/project" })
            @Html.ValidationMessageFor(m => m.RepoUrl, "", new { @class = "form-error" })
            <p class="form-hint">Leave empty if there is no public repository; the &ldquo;View Repo&rdquo; link is then hidden on Home.</p>
        </div>

        <div class="form-field form-field-narrow">
            <label class="form-label" for="SortOrder">Display order (optional)</label>
            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-input", maxlength = 4, inputmode = "numeric" })
            @Html.ValidationMessageFor(m => m.SortOrder, "", new { @class = "form-error" })
            <p class="form-hint">Lower numbers come first. Empty puts a new project last, or keeps the current position when editing.</p>
        </div>

        <div class="editor-actions">
            <button type="submit" class="pill-btn pill-btn-primary">Save project</button>
            <a class="pill-btn pill-btn-secondary" href="@listUrl">Cancel</a>
        </div>
    }
}
else if (!Model.LoadFailed && Model.Items.Count > 0)
{
    <!-- LIST -->
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Project</th>
                    <th scope="col">Tech stack</th>
                    <th scope="col">Role</th>
                    <th scope="col">Repo</th>
                    <th scope="col">Order</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    string repoUrl = FTQuiz2_UrlGuard.SafeHttpUrl(item.RepoUrl);
                    <tr>
                        <td class="cell-strong cell-wrap">@item.Title</td>
                        <td class="cell-wrap">@FTQuiz2_ContentFormat.OrDash(item.TechStack)</td>
                        <td class="cell-wrap">@FTQuiz2_ContentFormat.OrDash(item.Role)</td>
                        <td>
                            @if (repoUrl.Length == 0) { <text>@FTQuiz2_ContentFormat.Dash</text> }
                            else { <a href="@repoUrl" target="_blank" rel="noopener">Open</a> }
                        </td>
                        <td>@item.SortOrder</td>
                        <td class="cell-actions">
                            @using (Html.BeginForm("Index", "FTQuiz2_ManageContent", FormMethod.Get, new { @class = "inline-form" }))
                            {
                                <input type="hidden" name="tab" value="projects" />
                                <input type="hidden" name="edit" value="@item.ProjectId" />
                                <button type="submit" class="row-btn">Edit</button>
                            }
                            @using (Html.BeginForm("DeleteProject", "FTQuiz2_ManageContent", FormMethod.Post, new { @class = "inline-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.ProjectId" />
                                <button type="submit" class="row-btn row-btn-danger"
                                        data-confirm="@("Delete " + item.Title + "? This can't be undone.")"
                                        onclick="return confirm(this.getAttribute('data-confirm'));">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!Model.LoadFailed)
{
    <!-- EMPTY STATE -->
    <div class="empty-state">
        <p class="empty-title">No projects yet</p>
        <p class="empty-text">Click &ldquo;Add project&rdquo; to create the first one. Until you do, the Recent Projects board is hidden on Home.</p>
    </div>
}
