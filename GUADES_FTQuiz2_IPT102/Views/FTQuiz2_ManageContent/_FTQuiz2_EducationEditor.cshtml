@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_EducationEditorViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Port of Admin/Controls/EducationEditor.ascx.
    string listUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "education" });
    string addUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "education", add = "1" });
}

<div class="editor-head">
    <div>
        <h2 class="editor-title">Educational Attainment</h2>
        <p class="editor-intro">The schools shown on the Education board of Home.</p>
    </div>
    @if (!Model.ShowForm)
    {
        <a class="pill-btn pill-btn-primary" href="@addUrl">Add school</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="@(Model.MessageKind == "success" ? "alert alert-success" : "alert alert-error")" role="alert">@Model.Message</div>
}

@if (Model.ShowForm)
{
    <!-- ADD / EDIT FORM -->
    using (Html.BeginForm("SaveEducation", "FTQuiz2_ManageContent", FormMethod.Post,
        new { @class = "editor-card editor-form", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.EducationId)
        <h2>@(Model.IsEdit ? "Edit school" : "Add a school")</h2>

        <div class="form-field">
            <label class="form-label" for="SchoolName">School name</label>
            @Html.TextBoxFor(m => m.SchoolName, new { @class = "form-input", maxlength = 150 })
            @Html.ValidationMessageFor(m => m.SchoolName, "", new { @class = "form-error" })
        </div>

        <div class="form-row">
            <div class="form-field">
                <label class="form-label" for="Level">Level</label>
                @Html.TextBoxFor(m => m.Level, new { @class = "form-input", maxlength = 50, list = "educationLevels", autocomplete = "off" })
                <datalist id="educationLevels">
                    <option value="Elementary"></option>
                    <option value="Junior High School"></option>
                    <option value="Senior High School"></option>
                    <option value="College"></option>
                    <option value="Graduate School"></option>
                </datalist>
                @Html.ValidationMessageFor(m => m.Level, "", new { @class = "form-error" })
            </div>

            <div class="form-field">
                <label class="form-label" for="Program">Program (optional)</label>
                @Html.TextBoxFor(m => m.Program, new { @class = "form-input", maxlength = 150 })
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label class="form-label" for="StartYear">Start year (optional)</label>
                @Html.TextBoxFor(m => m.StartYear, new { @class = "form-input", maxlength = 4, inputmode = "numeric" })
                @Html.ValidationMessageFor(m => m.StartYear, "", new { @class = "form-error" })
            </div>

            <div class="form-field">
                <label class="form-label" for="EndYear">End year (optional)</label>
                @Html.TextBoxFor(m => m.EndYear, new { @class = "form-input", maxlength = 4, inputmode = "numeric" })
                @Html.ValidationMessageFor(m => m.EndYear, "", new { @class = "form-error" })
            </div>
        </div>
        @Html.ValidationMessage("Years", "", new { @class = "form-error" })
        <p class="form-hint">Leave the end year empty if you are still studying there. Leave both empty if the years are unknown; they are then hidden.</p>

        <div class="form-field">
            <label class="form-label" for="Description">Description (optional)</label>
            @Html.TextAreaFor(m => m.Description, 4, 20, new { @class = "form-input form-textarea", maxlength = 1000 })
        </div>

        <div class="form-field">
            <span class="form-label">Photo (optional)</span>
            <div class="avatar-edit">
                @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
                {
                    <div><img class="photo-preview" src="@Model.CurrentPhotoUrl" alt="Current photo" /></div>
                }
                <div class="avatar-controls">
                    <input type="file" name="photo" class="form-file" accept=".jpg,.jpeg,.png,.gif" />
                    <p class="form-hint">JPG, PNG or GIF, up to 5 MB. When editing, leave empty to keep the current photo.</p>
                </div>
            </div>
        </div>

        <div class="form-field form-field-narrow">
            <label class="form-label" for="SortOrder">Display order (optional)</label>
            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-input", maxlength = 4, inputmode = "numeric" })
            @Html.ValidationMessageFor(m => m.SortOrder, "", new { @class = "form-error" })
            <p class="form-hint">Lower numbers come first. Empty puts a new school last, or keeps the current position when editing.</p>
        </div>

        <div class="editor-actions">
            <button type="submit" class="pill-btn pill-btn-primary">Save school</button>
            <a class="pill-btn pill-btn-secondary" href="@listUrl">Cancel</a>
        </div>
    }
}
else if (!Model.LoadFailed && Model.Items.Count > 0)
{
    <!-- LIST -->
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Photo</th>
                    <th scope="col">School</th>
                    <th scope="col">Level</th>
                    <th scope="col">Program</th>
                    <th scope="col">Years</th>
                    <th scope="col">Order</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    string thumb = FTQuiz2_ContentFormat.ThumbUrl(item.PhotoPath);
                    <tr>
                        <td>
                            @if (thumb.Length == 0) { <span class="thumb thumb-empty"></span> }
                            else { <img class="thumb" src="@thumb" alt="" /> }
                        </td>
                        <td class="cell-strong cell-wrap">@item.SchoolName</td>
                        <td>@item.Level</td>
                        <td class="cell-wrap">@item.Program</td>
                        <td>@FTQuiz2_ContentFormat.FormatYears(item.StartYear, item.EndYear)</td>
                        <td>@item.SortOrder</td>
                        <td class="cell-actions">
                            @using (Html.BeginForm("Index", "FTQuiz2_ManageContent", FormMethod.Get, new { @class = "inline-form" }))
                            {
                                <input type="hidden" name="tab" value="education" />
                                <input type="hidden" name="edit" value="@item.EducationId" />
                                <button type="submit" class="row-btn">Edit</button>
                            }
                            @using (Html.BeginForm("DeleteEducation", "FTQuiz2_ManageContent", FormMethod.Post, new { @class = "inline-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.EducationId" />
                                <button type="submit" class="row-btn row-btn-danger"
                                        data-confirm="@("Delete " + item.SchoolName + " (" + item.Level + ")? This can't be undone.")"
                                        onclick="return confirm(this.getAttribute('data-confirm'));">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!Model.LoadFailed)
{
    <!-- EMPTY STATE -->
    <div class="empty-state">
        <p class="empty-title">No schools yet</p>
        <p class="empty-text">Click &ldquo;Add school&rdquo; to create the first one.</p>
    </div>
}
