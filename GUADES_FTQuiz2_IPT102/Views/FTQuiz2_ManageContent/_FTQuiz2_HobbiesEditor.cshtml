@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_HobbiesEditorViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Port of Admin/Controls/HobbiesEditor.ascx.
    string listUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "hobbies" });
    string addUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "hobbies", add = "1" });
}

<div class="editor-head">
    <div>
        <h2 class="editor-title">Hobbies &amp; Interest</h2>
        <p class="editor-intro">The pins shown on the Interests board of Home. A hobby without a photo appears as a text card.</p>
    </div>
    @if (!Model.ShowForm)
    {
        <a class="pill-btn pill-btn-primary" href="@addUrl">Add hobby</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="@(Model.MessageKind == "success" ? "alert alert-success" : "alert alert-error")" role="alert">@Model.Message</div>
}

@if (Model.ShowForm)
{
    <!-- ADD / EDIT FORM -->
    using (Html.BeginForm("SaveHobby", "FTQuiz2_ManageContent", FormMethod.Post,
        new { @class = "editor-card editor-form", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.HobbyId)
        <h2>@(Model.IsEdit ? "Edit hobby" : "Add a hobby")</h2>

        <div class="form-field">
            <label class="form-label" for="Title">Title</label>
            @Html.TextBoxFor(m => m.Title, new { @class = "form-input", maxlength = 100 })
            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "form-error" })
        </div>

        <div class="form-field">
            <label class="form-label" for="Description">Description (optional)</label>
            @Html.TextAreaFor(m => m.Description, 3, 20, new { @class = "form-input form-textarea", maxlength = 500 })
            <p class="form-hint">One or two sentences, up to 500 characters.</p>
        </div>

        <div class="form-field">
            <span class="form-label">Photo (optional)</span>
            <div class="avatar-edit">
                @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
                {
                    <div><img class="photo-preview" src="@Model.CurrentPhotoUrl" alt="Current photo" /></div>
                }
                <div class="avatar-controls">
                    <input type="file" name="photo" class="form-file" accept=".jpg,.jpeg,.png,.gif" />
                    <p class="form-hint">JPG, PNG or GIF, up to 5 MB. When editing, leave empty to keep the current photo.</p>
                </div>
            </div>
        </div>

        <div class="form-field form-field-narrow">
            <label class="form-label" for="SortOrder">Display order (optional)</label>
            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-input", maxlength = 4, inputmode = "numeric" })
            @Html.ValidationMessageFor(m => m.SortOrder, "", new { @class = "form-error" })
            <p class="form-hint">Lower numbers come first. Empty puts a new hobby last, or keeps the current position when editing.</p>
        </div>

        <div class="editor-actions">
            <button type="submit" class="pill-btn pill-btn-primary">Save hobby</button>
            <a class="pill-btn pill-btn-secondary" href="@listUrl">Cancel</a>
        </div>
    }
}
else if (!Model.LoadFailed && Model.Items.Count > 0)
{
    <!-- LIST -->
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Photo</th>
                    <th scope="col">Title</th>
                    <th scope="col">Description</th>
                    <th scope="col">Order</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    string thumb = FTQuiz2_ContentFormat.ThumbUrl(item.ImagePath);
                    <tr>
                        <td>
                            @if (thumb.Length == 0) { <span class="thumb thumb-empty"></span> }
                            else { <img class="thumb" src="@thumb" alt="" /> }
                        </td>
                        <td class="cell-strong cell-wrap">@item.Title</td>
                        <td class="cell-wrap">@FTQuiz2_ContentFormat.Preview(item.Description, 80)</td>
                        <td>@item.SortOrder</td>
                        <td class="cell-actions">
                            @using (Html.BeginForm("Index", "FTQuiz2_ManageContent", FormMethod.Get, new { @class = "inline-form" }))
                            {
                                <input type="hidden" name="tab" value="hobbies" />
                                <input type="hidden" name="edit" value="@item.HobbyId" />
                                <button type="submit" class="row-btn">Edit</button>
                            }
                            @using (Html.BeginForm("DeleteHobby", "FTQuiz2_ManageContent", FormMethod.Post, new { @class = "inline-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.HobbyId" />
                                <button type="submit" class="row-btn row-btn-danger"
                                        data-confirm="@("Delete " + item.Title + "? This can't be undone.")"
                                        onclick="return confirm(this.getAttribute('data-confirm'));">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!Model.LoadFailed)
{
    <!-- EMPTY STATE -->
    <div class="empty-state">
        <p class="empty-title">No hobbies yet</p>
        <p class="empty-text">Click &ldquo;Add hobby&rdquo; to create the first one. Until you do, the Interests board is hidden on Home.</p>
    </div>
}
