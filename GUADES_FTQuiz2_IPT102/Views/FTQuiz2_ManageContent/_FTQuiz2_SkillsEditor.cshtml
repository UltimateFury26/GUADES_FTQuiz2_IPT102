@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_SkillsEditorViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Port of Admin/Controls/SkillsEditor.ascx.
    string listUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "skills" });
    string addUrl = Url.Action("Index", "FTQuiz2_ManageContent", new { tab = "skills", add = "1" });
}

<div class="editor-head">
    <div>
        <h2 class="editor-title">Skills</h2>
        <p class="editor-intro">Each skill appears on the board for its category: Frontend, Backend, or Tools &amp; Platforms.</p>
    </div>
    @if (!Model.ShowForm)
    {
        <a class="pill-btn pill-btn-primary" href="@addUrl">Add skill</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="@(Model.MessageKind == "success" ? "alert alert-success" : "alert alert-error")" role="alert">@Model.Message</div>
}

@if (Model.ShowForm)
{
    <!-- ADD / EDIT FORM -->
    using (Html.BeginForm("SaveSkill", "FTQuiz2_ManageContent", FormMethod.Post, new { @class = "editor-card editor-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.SkillId)
        <h2>@(Model.IsEdit ? "Edit skill" : "Add a skill")</h2>

        <div class="form-row">
            <div class="form-field">
                <label class="form-label" for="Name">Skill name</label>
                @Html.TextBoxFor(m => m.Name, new { @class = "form-input", maxlength = 100 })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "form-error" })
            </div>

            <div class="form-field">
                <label class="form-label" for="Category">Category</label>
                @Html.DropDownListFor(m => m.Category, Model.CategoryOptions, new { @class = "form-input" })
                @Html.ValidationMessageFor(m => m.Category, "", new { @class = "form-error" })
            </div>
        </div>

        <div class="form-field">
            <label class="form-label" for="Description">Description (optional)</label>
            @Html.TextAreaFor(m => m.Description, 5, 20, new { @class = "form-input form-textarea", maxlength = 1500 })
            <p class="form-hint">Shown when a visitor opens the skill. Up to 1500 characters.</p>
        </div>

        <div class="form-field form-field-narrow">
            <label class="form-label" for="SortOrder">Display order (optional)</label>
            @Html.TextBoxFor(m => m.SortOrder, new { @class = "form-input", maxlength = 4, inputmode = "numeric" })
            @Html.ValidationMessageFor(m => m.SortOrder, "", new { @class = "form-error" })
            <p class="form-hint">Lower numbers come first. Empty puts a new skill last, or keeps the current position when editing.</p>
        </div>

        <div class="editor-actions">
            <button type="submit" class="pill-btn pill-btn-primary">Save skill</button>
            <a class="pill-btn pill-btn-secondary" href="@listUrl">Cancel</a>
        </div>
    }
}
else if (!Model.LoadFailed && Model.Items.Count > 0)
{
    <!-- LIST -->
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Skill</th>
                    <th scope="col">Category</th>
                    <th scope="col">Description</th>
                    <th scope="col">Order</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="cell-strong cell-wrap">@item.Name</td>
                        <td><span class="badge badge-user">@FTQuiz2_ContentFormat.CategoryLabel(item.Category)</span></td>
                        <td class="cell-wrap cell-desc">@FTQuiz2_ContentFormat.Preview(item.Description, 90)</td>
                        <td>@item.SortOrder</td>
                        <td class="cell-actions">
                            @using (Html.BeginForm("Index", "FTQuiz2_ManageContent", FormMethod.Get, new { @class = "inline-form" }))
                            {
                                <input type="hidden" name="tab" value="skills" />
                                <input type="hidden" name="edit" value="@item.SkillId" />
                                <button type="submit" class="row-btn">Edit</button>
                            }
                            @using (Html.BeginForm("DeleteSkill", "FTQuiz2_ManageContent", FormMethod.Post, new { @class = "inline-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.SkillId" />
                                <button type="submit" class="row-btn row-btn-danger"
                                        data-confirm="@("Delete " + item.Name + "? This can't be undone.")"
                                        onclick="return confirm(this.getAttribute('data-confirm'));">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!Model.LoadFailed)
{
    <!-- EMPTY STATE -->
    <div class="empty-state">
        <p class="empty-title">No skills yet</p>
        <p class="empty-text">Click &ldquo;Add skill&rdquo; to create the first one.</p>
    </div>
}
