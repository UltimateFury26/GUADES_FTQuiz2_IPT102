@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_ContactViewModel
@{
    // Contact information from the database (usp_ContactInfo_Get) through HomeController.Contact.
    // A line is drawn only when its value exists; links are already checked (http/https only, safe mailto).
    // This page is display only: there is no contact form, so nothing here pretends to send a message.
    ViewBag.Title = "Contact";
}

<header class="mm-page-head">
    <span class="mm-eyebrow">Contact</span>
    <h1 class="mm-page-head__title">Get in touch with @Model.BusinessName</h1>
</header>

<section class="mm-section" aria-label="Contact details">
    @if (Model.HasContact)
    {
        <ul class="mm-contact-list">
            @if (Model.Email.Length > 0)
            {
                <li><span class="mm-contact-list__label">Email</span><a href="@("mailto:" + Model.Email)">@Model.Email</a></li>
            }
            @if (Model.PhoneDisplay.Length > 0)
            {
                <li>
                    <span class="mm-contact-list__label">Phone</span>
                    @if (Model.PhoneHref.Length > 0)
                    {
                        <a href="@("tel:" + Model.PhoneHref)">@Model.PhoneDisplay</a>
                    }
                    else
                    {
                        <span>@Model.PhoneDisplay</span>
                    }
                </li>
            }
            @if (Model.Address.Length > 0)
            {
                <li><span class="mm-contact-list__label">Address</span><span class="mm-prose">@Model.Address</span></li>
            }
            @if (Model.FacebookUrl.Length > 0)
            {
                <li><span class="mm-contact-list__label">Facebook</span><a href="@Model.FacebookUrl" target="_blank" rel="noopener noreferrer">@GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_BusinessFormat.DisplayUrl(Model.FacebookUrl)</a></li>
            }
            @if (Model.InstagramUrl.Length > 0)
            {
                <li><span class="mm-contact-list__label">Instagram</span><a href="@Model.InstagramUrl" target="_blank" rel="noopener noreferrer">@GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_BusinessFormat.DisplayUrl(Model.InstagramUrl)</a></li>
            }
        </ul>
    }
    else
    {
        <p class="mm-empty">Contact details will be available soon.</p>
    }

    <div class="mm-actions">
        <a class="pill-btn pill-btn-secondary" href="@Url.Action("Owners", "FTQuiz2_Business")">Owners / Company</a>
        <a class="pill-btn pill-btn-secondary" href="@Url.Action("Index", "FTQuiz2_Products")">Our products</a>
    </div>
</section>
