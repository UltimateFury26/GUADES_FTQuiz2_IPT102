@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_AboutUsViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // One public destination for the company introduction, contact details and owner directory.
    // All editable details come from the existing SQL-backed business profile/contact/owner records.
    ViewBag.Title = "About Us";
}

<div class="mm-aboutus-page">
    <section class="mm-aboutus-hero" aria-labelledby="aboutusTitle">
        <div class="mm-aboutus-hero__visual">
            @if (Model.HeroImageUrl.Length > 0)
            {
                <img src="@Model.HeroImageUrl" alt="Mogu Mogu drinks" decoding="async" />
            }
            else
            {
                <div class="mm-aboutus-hero__fallback" aria-hidden="true">MOGU MOGU</div>
            }
        </div>
        <div class="mm-aboutus-hero__copy">
            <p class="mm-aboutus-hero__eyebrow">The people and company behind the brand</p>
            <h1 id="aboutusTitle">@Model.BusinessName</h1>
            @if (Model.Tagline.Length > 0)
            {
                <p class="mm-aboutus-hero__tagline">@Model.Tagline</p>
            }
            @if (Model.HasBrandStory)
            {
                <p class="mm-aboutus-hero__story">@Model.BrandStory</p>
            }
            <a class="pill-btn pill-btn-primary" href="#aboutus-contact">Get in touch</a>
        </div>
    </section>

    <section class="mm-aboutus-contact-section" id="aboutus-contact" aria-labelledby="aboutusContactTitle">
        <div class="mm-aboutus-section-heading">
            <p class="mm-aboutus-section-heading__eyebrow">We'd love to hear from you</p>
            <h2 id="aboutusContactTitle">Get in touch</h2>
            <p>For questions and enquiries, use the contact details below.</p>
        </div>

        @if (Model.HasContact)
        {
            <div class="mm-aboutus-contact-grid">
                @if (Model.Email.Length > 0)
                {
                    <article class="mm-aboutus-contact-card">
                        <span class="mm-aboutus-contact-card__label">Email us</span>
                        <a href="@("mailto:" + Model.Email)">@Model.Email</a>
                    </article>
                }
                @if (Model.PhoneDisplay.Length > 0)
                {
                    <article class="mm-aboutus-contact-card">
                        <span class="mm-aboutus-contact-card__label">Call us</span>
                        @if (Model.PhoneHref.Length > 0)
                        {
                            <a href="@("tel:" + Model.PhoneHref)">@Model.PhoneDisplay</a>
                        }
                        else
                        {
                            <span>@Model.PhoneDisplay</span>
                        }
                    </article>
                }
                @if (Model.Address.Length > 0)
                {
                    <article class="mm-aboutus-contact-card">
                        <span class="mm-aboutus-contact-card__label">Find us</span>
                        <span>@Model.Address</span>
                    </article>
                }
                @if (Model.FacebookUrl.Length > 0)
                {
                    <article class="mm-aboutus-contact-card">
                        <span class="mm-aboutus-contact-card__label">Facebook</span>
                        <a href="@Model.FacebookUrl" target="_blank" rel="noopener">@FTQuiz2_BusinessFormat.DisplayUrl(Model.FacebookUrl)</a>
                    </article>
                }
                @if (Model.InstagramUrl.Length > 0)
                {
                    <article class="mm-aboutus-contact-card">
                        <span class="mm-aboutus-contact-card__label">Instagram</span>
                        <a href="@Model.InstagramUrl" target="_blank" rel="noopener">@FTQuiz2_BusinessFormat.DisplayUrl(Model.InstagramUrl)</a>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="mm-empty">Contact details will be available here once they have been added by the business.</p>
        }
    </section>

    <section class="mm-aboutus-team-section" aria-labelledby="aboutusTeamTitle">
        <div class="mm-aboutus-section-heading mm-aboutus-section-heading--left">
            <p class="mm-aboutus-section-heading__eyebrow">The people behind the name</p>
            <h2 id="aboutusTeamTitle">Owners &amp; company</h2>
            <p>Company and representative information supplied by the business.</p>
        </div>

        @if (Model.HasOwners)
        {
            <div class="mm-aboutus-team">
                @foreach (var owner in Model.Owners)
                {
                    <article class="mm-aboutus-person @(owner.IsPlaceholder ? "mm-aboutus-person--placeholder" : "")">
                        <div class="mm-aboutus-person__avatar" aria-hidden="true">
                            @if (owner.PhotoUrl.Length > 0)
                            {
                                <img src="@owner.PhotoUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                @owner.Initial
                            }
                        </div>
                        <div class="mm-aboutus-person__content">
                            @if (owner.IsPlaceholder)
                            {
                                <span class="mm-aboutus-person__status">Information to be completed</span>
                            }
                            <h3 class="mm-aboutus-person__name">@owner.FullName</h3>
                            @if (owner.Position.Length > 0)
                            {
                                <p class="mm-aboutus-person__role">@owner.Position</p>
                            }
                            @if (owner.Bio.Length > 0)
                            {
                                <p class="mm-aboutus-person__bio">@owner.Bio</p>
                            }
                            @if (owner.Email.Length > 0)
                            {
                                <a class="mm-aboutus-person__email" href="@("mailto:" + owner.Email)">@owner.Email</a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="mm-empty">Company and representative details will appear here when available.</p>
        }
    </section>

    <section class="mm-aboutus-cta">
        <div>
            <h2>Discover the Mogu Mogu range</h2>
            <p>Explore the published flavours and find the one you want to try next.</p>
        </div>
        <a class="pill-btn pill-btn-primary" href="@Url.Action("Index", "FTQuiz2_Products")">Explore products</a>
    </section>
</div>
