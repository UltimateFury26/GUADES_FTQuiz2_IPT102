@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_HomeViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Port of Home.aspx (Site.Master shell comes from _ViewStart). Class names, ids, data-* hooks,
    // texts and the hide-when-empty rules are the source's; FTQuiz2_Portfolio.js drives the overlays.
    ViewBag.Title = "Home";
    string galleryCover = "cover-quad" + Model.GalleryCoverClass;
    string interestCover = "cover-quad" + Model.InterestCoverClass;
}

<!-- PROFILE HEADER -->
<section class="profile-header">
    @if (Model.AvatarUrl.Length > 0)
    {
        <img src="@Model.AvatarUrl" alt="@Model.FullName" class="profile-avatar" />
    }
    <h1 class="profile-name">@Model.FullName</h1>
    @if (Model.Tagline.Length > 0)
    {
        <p class="profile-tagline">@Model.Tagline</p>
    }
    @if (Model.Bio.Length > 0)
    {
        <p class="profile-bio">@Model.Bio</p>
    }
    <div class="profile-actions">
        <button type="button" class="pill-btn pill-btn-primary" data-modal="contactModal">
            <svg class="icon" viewBox="0 0 24 24" style="width:16px;height:16px"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="12" r="2" /><path d="M14 10h5" /><path d="M14 14h5" /></svg>
            Contact
        </button>
    </div>
</section>

<!-- LATEST ANNOUNCEMENT (hidden when nothing is published) -->
@if (Model.LatestPost != null)
{
    <section class="announcement-card" aria-label="Latest announcement">
        <p class="announcement-label">Latest announcement</p>
        <h2 class="announcement-title">@Model.LatestPost.Title</h2>
        <p class="announcement-date">@Model.LatestPostDate</p>
        <p class="announcement-body">@Model.LatestPost.Body</p>
    </section>
}

<!-- BOARDS -->
<section id="boards">
    <div class="boards-heading-row">
        <h2 class="boards-heading">Boards</h2>
        <span class="boards-count" id="boardsCount">@Model.BoardCount boards</span>
    </div>

    <div class="board-grid">

        @if (Model.Posts.Count > 0)
        {
            <button type="button" class="board-tile" data-board="announcements" data-title="Announcements">
                <div class="board-cover cover-solid" style="background:#d51007">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg>
                </div>
                <div class="board-meta">
                    <p class="board-title">Announcements</p>
                    <p class="board-sub">@Model.PinCountText(Model.Posts.Count)</p>
                </div>
            </button>
        }

        @if (Model.Projects.Count > 0)
        {
            <button type="button" class="board-tile" data-board="projects" data-title="Recent Projects">
                <div class="board-cover cover-solid" style="background:#23272f">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" /></svg>
                </div>
                <div class="board-meta">
                    <p class="board-title">Recent Projects</p>
                    <p class="board-sub">@Model.PinCountText(Model.Projects.Count)</p>
                </div>
            </button>
        }

        @foreach (var board in Model.SkillBoards)
        {
            <button type="button" class="board-tile" data-board="@board.Key" data-title="@board.Title">
                <div class="board-cover cover-solid" style="background:@board.Color">
                    <svg class="icon" viewBox="0 0 24 24">@Html.Raw(board.IconMarkup)</svg>
                </div>
                <div class="board-meta">
                    <p class="board-title">@board.Title</p>
                    <p class="board-sub">@Model.PinCountText(board.Skills.Count)</p>
                </div>
            </button>
        }

        @if (Model.Schools.Count > 0)
        {
            <button type="button" class="board-tile" data-board="education" data-title="Education">
                <div class="board-cover cover-solid" style="background:#47543d">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5-10-5z" /><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5" /><path d="M22 9v6" /></svg>
                </div>
                <div class="board-meta">
                    <p class="board-title">Education</p>
                    <p class="board-sub">@Model.PinCountText(Model.Schools.Count)</p>
                </div>
            </button>
        }

        @if (Model.GalleryPhotos.Count > 0)
        {
            <button type="button" class="board-tile board-tile-wide" data-board="gallery" data-title="Gallery">
                <div class="board-cover">
                    <div class="@galleryCover">
                        <img class="cover-main" src="@Model.GalleryPhotos[0].Url" alt="" />
                        @if (Model.GalleryPhotos.Count > 1)
                        {
                            <div class="cover-stack">
                                @for (int slot = 1; slot < Model.GalleryPhotos.Count && slot <= 3; slot++)
                                {
                                    <img src="@Model.GalleryPhotos[slot].Url" alt="" />
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="board-meta">
                    <p class="board-title">Gallery</p>
                    <p class="board-sub">@Model.PinCountText(Model.GalleryPhotos.Count)</p>
                </div>
            </button>
        }

        @if (Model.Hobbies.Count > 0)
        {
            <button type="button" class="board-tile board-tile-wide" data-board="interests" data-title="Interests">
                <div class="board-cover">
                    <div class="@interestCover">
                        @if (Model.InterestPreview.Count == 0)
                        {
                            <div class="cover-solid" style="background:#3d4a63">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z" /></svg>
                            </div>
                        }
                        else
                        {
                            <img class="cover-main" src="@Model.InterestPreview[0]" alt="" />
                            if (Model.InterestPreview.Count > 1)
                            {
                                <div class="cover-stack">
                                    @for (int slot = 1; slot < Model.InterestPreview.Count; slot++)
                                    {
                                        <img src="@Model.InterestPreview[slot]" alt="" />
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="board-meta">
                    <p class="board-title">Interests</p>
                    <p class="board-sub">@Model.PinCountText(Model.Hobbies.Count)</p>
                </div>
            </button>
        }

    </div>
</section>

<!-- ================= BOARD OVERLAYS ================= -->

<!-- Announcements board -->
@if (Model.Posts.Count > 0)
{
    <div class="modal-overlay" id="announcementsBoard">
        <div class="modal-box board-box">
            @Html.Partial("_FTQuiz2_BoardModal", new FTQuiz2_BoardHeaderViewModel
            {
                Title = "Announcements",
                CountText = Model.PinCountText(Model.Posts.Count),
                Description = "News and updates posted on this site."
            })
            <div class="pin-grid">
                @for (int i = 0; i < Model.Posts.Count; i++)
                {
                    <button type="button" class="pin-card" data-modal="@("postModal" + Model.Posts[i].PostId)">
                        <div class="pin-cover" style="@Model.PinStyle(i)">
                            <svg class="icon" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg>
                        </div>
                        <p class="pin-label">@Model.Posts[i].Title</p>
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Projects board -->
@if (Model.Projects.Count > 0)
{
    <div class="modal-overlay" id="projectsBoard">
        <div class="modal-box board-box">
            @Html.Partial("_FTQuiz2_BoardModal", new FTQuiz2_BoardHeaderViewModel
            {
                Title = "Recent Projects",
                CountText = Model.PinCountText(Model.Projects.Count),
                Description = "A running list of things I've built, from class exercises to bigger side projects."
            })
            <div class="pin-grid">
                @for (int i = 0; i < Model.Projects.Count; i++)
                {
                    <button type="button" class="pin-card" data-modal="@("projectModal" + Model.Projects[i].ProjectId)">
                        <div class="pin-cover" style="@Model.PinStyle(i)">
                            <svg class="icon" viewBox="0 0 24 24"><path d="M9 18 3 12l6-6" /><path d="M15 6l6 6-6 6" /></svg>
                        </div>
                        <p class="pin-label">@Model.Projects[i].Title</p>
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Skill boards: Frontend, Backend, Tools -->
@foreach (var board in Model.SkillBoards)
{
    <div class="modal-overlay" id="@board.OverlayId">
        <div class="modal-box board-box">
            @Html.Partial("_FTQuiz2_BoardModal", new FTQuiz2_BoardHeaderViewModel
            {
                Title = board.Title,
                CountText = Model.PinCountText(board.Skills.Count),
                Description = board.Description
            })
            <div class="pin-grid">
                @for (int i = 0; i < board.Skills.Count; i++)
                {
                    <button type="button" class="pin-card" data-modal="@("skillModal" + board.Skills[i].SkillId)">
                        <div class="pin-cover" style="@Model.PinStyle(i)">
                            <svg class="icon" viewBox="0 0 24 24">@Html.Raw(board.IconMarkup)</svg>
                        </div>
                        <p class="pin-label">@board.Skills[i].Name</p>
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Education board -->
@if (Model.Schools.Count > 0)
{
    <div class="modal-overlay" id="educationBoard">
        <div class="modal-box board-box">
            @Html.Partial("_FTQuiz2_BoardModal", new FTQuiz2_BoardHeaderViewModel
            {
                Title = "Education",
                CountText = Model.PinCountText(Model.Schools.Count),
                Description = "Where I've studied and what I'm working toward."
            })
            <div class="pin-grid">
                @for (int i = 0; i < Model.Schools.Count; i++)
                {
                    string photo = Model.PhotoUrl(Model.Schools[i].PhotoPath);
                    <button type="button" class="pin-card" data-modal="@("schoolModal" + Model.Schools[i].EducationId)">
                        <div class="pin-cover" style="@Model.CoverStyle(photo, i)">
                            @if (photo.Length > 0)
                            {
                                <img src="@photo" alt="@Model.SchoolLabel(Model.Schools[i])" />
                            }
                            else
                            {
                                <svg class="icon" viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5-10-5z" /><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5" /><path d="M22 9v6" /></svg>
                            }
                        </div>
                        <p class="pin-label">@Model.SchoolLabel(Model.Schools[i])</p>
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Gallery board (opens the shared lightbox) -->
@if (Model.GalleryPhotos.Count > 0)
{
    <div class="modal-overlay" id="galleryBoard">
        <div class="modal-box board-box">
            @Html.Partial("_FTQuiz2_BoardModal", new FTQuiz2_BoardHeaderViewModel
            {
                Title = "Gallery",
                CountText = Model.PinCountText(Model.GalleryPhotos.Count),
                Description = "A few photos worth sharing."
            })
            <div class="pin-grid">
                @foreach (var photo in Model.GalleryPhotos)
                {
                    <div class="pin-item">
                        <div class="pin-cover" style="cursor:pointer">
                            <img src="@photo.Url" alt="@photo.Alt" data-lightbox="@photo.Url" data-caption="@photo.Caption" />
                        </div>
                        @if (photo.Caption.Length > 0)
                        {
                            <p class="pin-label">@photo.Caption</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Interests board (masonry). A hobby with a photo opens the lightbox; one without is a text card. -->
@if (Model.Hobbies.Count > 0)
{
    <div class="modal-overlay" id="interestsBoard">
        <div class="modal-box board-box">
            @Html.Partial("_FTQuiz2_BoardModal", new FTQuiz2_BoardHeaderViewModel
            {
                Title = "Interests",
                CountText = Model.PinCountText(Model.Hobbies.Count),
                Description = "Things I like outside of code."
            })
            <div class="masonry-grid">
                @foreach (var hobby in Model.Hobbies)
                {
                    if (hobby.ImageUrl.Length > 0)
                    {
                        <div class="masonry-item">
                            <img src="@hobby.ImageUrl" alt="@hobby.Title" data-lightbox="@hobby.ImageUrl" />
                            <div class="masonry-caption">
                                <strong>@hobby.Title</strong>
                                @if (hobby.Description.Length > 0)
                                {
                                    <span>@hobby.Description</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="masonry-item masonry-text" style="@hobby.CardStyle">
                            <p class="masonry-text-title">@hobby.Title</p>
                            @if (hobby.Description.Length > 0)
                            {
                                <p class="masonry-text-desc">@hobby.Description</p>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<!-- ================= PIN DETAIL MODALS ================= -->

@foreach (var post in Model.Posts)
{
    @Html.Partial("_FTQuiz2_PinModal", Model.PostModal(post))
}

@foreach (var project in Model.Projects)
{
    @Html.Partial("_FTQuiz2_PinModal", Model.ProjectModal(project))
}

@foreach (var school in Model.Schools)
{
    @Html.Partial("_FTQuiz2_PinModal", Model.SchoolModal(school))
}

@foreach (var board in Model.SkillBoards)
{
    foreach (var skill in board.Skills)
    {
        @Html.Partial("_FTQuiz2_PinModal", Model.SkillModal(skill))
    }
}

<!-- LIGHTBOX (shared by the Gallery and Interests boards) -->
@Html.Partial("_FTQuiz2_Lightbox")
