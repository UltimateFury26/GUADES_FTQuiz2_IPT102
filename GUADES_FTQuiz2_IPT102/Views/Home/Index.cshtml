@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_HomeViewModel
@{
    // Mogu Mogu homepage. Every piece of content below comes from SQL Server through the controller:
    // business profile (hero, story, mission/vision), published products, latest news and contact information.
    // Nothing is hard-coded, and each block hides itself when it has nothing to show.
    ViewBag.Title = "Home";
}

<!-- HERO -->
<section class="mm-hero" aria-labelledby="heroTitle">
    <div class="mm-hero__text">
        <h1 class="mm-hero__title" id="heroTitle">@Model.HeadlineText</h1>
        @if (Model.Mission.Length > 0)
        {
            <p class="mm-hero__lead">@Model.Mission</p>
        }
        <div class="mm-hero__actions">
            <a class="pill-btn pill-btn-primary" href="@Url.Action("Index", "FTQuiz2_Products")">See our products <span aria-hidden="true">&rarr;</span></a>
            <a class="pill-btn pill-btn-secondary" href="#our-story">Our story</a>
        </div>
    </div>
    @if (Model.HeroUrl.Length > 0)
    {
        <div class="mm-hero__visual">
            <figure class="mm-hero__frame">
                <img src="@Model.HeroUrl" alt="@Model.BusinessName drinks" decoding="async" />
            </figure>
        </div>
    }
    else
    {
        <div class="mm-hero__visual mm-hero__visual--ph" aria-hidden="true">
            <span class="mm-bubble mm-bubble--lg"></span>
            <span class="mm-bubble mm-bubble--md"></span>
            <span class="mm-bubble mm-bubble--sm"></span>
        </div>
    }
</section>

<!-- MOVING BRAND BAND -->
<div class="mg-band" data-mg-marquee aria-hidden="true">
    <div class="mg-band__track">
        <div class="mg-band__group">
            <span class="mg-band__item">You gotta chew</span>
            <span class="mg-band__item">Mogu Mogu</span>
            <span class="mg-band__item">Nata de coco</span>
            <span class="mg-band__item">Real fruit juice</span>
        </div>
    </div>
</div>

<div class="mm-home">

<!-- FEATURED PRODUCTS -->
<section class="mm-section" id="products" aria-labelledby="productsTitle" data-mg-reveal>
    <div class="mm-section__head mm-section__head--center">
        <h2 class="mm-section__title" id="productsTitle">Featured products</h2>
    </div>

    @if (Model.FeaturedProducts.Count == 0)
    {
        <p class="mm-empty">Our products are being updated. Please check back soon.</p>
    }
    else
    {
        <div class="mm-product-grid">
            @foreach (var product in Model.FeaturedProducts)
            {
                <article class="mm-product" data-mg-tilt>
                    <button type="button" class="mm-product__btn" data-modal="@product.ModalId" aria-label="View details of @product.Name">
                        <span class="mm-product__media">
                            @if (product.ImageUrl.Length > 0)
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                            }
                            else
                            {
                                <span class="mm-product__ph" aria-hidden="true">@product.PlaceholderLetter</span>
                            }
                        </span>
                        <span class="mm-product__body">
                            @if (product.Flavor.Length > 0)
                            {
                                <span class="mm-badge">@product.Flavor</span>
                            }
                            <span class="mm-product__name">@product.Name</span>
                            @if (product.ShortDescription.Length > 0)
                            {
                                <span class="mm-product__desc">@product.ShortDescription</span>
                            }
                            <span class="mm-product__more">View details</span>
                        </span>
                    </button>
                </article>
            }
        </div>
        <div class="mm-actions">
            <a class="pill-btn pill-btn-secondary" href="@Url.Action("Index", "FTQuiz2_Products")">View all products</a>
        </div>
    }
</section>

@foreach (var product in Model.FeaturedProducts)
{
    @Html.Partial("_FTQuiz2_ProductModal", product)
}

<!-- OUR STORY (brand introduction + about preview) -->
<section class="mm-section mm-section--tint" id="our-story" aria-labelledby="storyTitle" data-mg-reveal>
    <div class="mm-story @(Model.AboutImageUrl.Length > 0 ? "mm-story--with-image" : "")">
        <div class="mm-story__text">
            <h2 class="mm-section__title" id="storyTitle">Our story</h2>
            @if (Model.StoryPreview.Length > 0)
            {
                <p class="mm-story__body">@Model.StoryPreview</p>
            }
            else
            {
                <p class="mm-empty">The brand story will be added soon.</p>
            }
            <a class="pill-btn pill-btn-secondary" href="@Url.Action("About", "Home")">Read our full story</a>
        </div>
        @if (Model.AboutImageUrl.Length > 0)
        {
            <div class="mm-story__media"><img src="@Model.AboutImageUrl" alt="About @Model.BusinessName" loading="lazy" /></div>
        }
    </div>

    @if (Model.HasHighlights)
    {
        <div class="mm-highlights">
            @if (Model.Mission.Length > 0)
            {
                <article class="mm-highlight">
                    <h3>Our mission</h3>
                    <p>@Model.Mission</p>
                </article>
            }
            @if (Model.Vision.Length > 0)
            {
                <article class="mm-highlight">
                    <h3>Our vision</h3>
                    <p>@Model.Vision</p>
                </article>
            }
        </div>
    }
</section>

<!-- LATEST NEWS (hidden when nothing is published) -->
@if (Model.LatestPost != null)
{
    <section class="mm-section" aria-label="Latest news">
        <article class="announcement-card mm-news">
            <p class="announcement-label">Latest news</p>
            <h2 class="announcement-title">@Model.LatestPost.Title</h2>
            <p class="announcement-date">@Model.LatestPostDate</p>
            <p class="announcement-body">@Model.LatestPost.Body</p>
        </article>
    </section>
}

<!-- CONTACT PREVIEW -->
<section class="mm-section" id="contact" aria-labelledby="contactTitle">
    <div class="mm-section__head mm-section__head--center">
        <h2 class="mm-section__title" id="contactTitle">Get in touch</h2>
    </div>

    @if (Model.HasContact)
    {
        <ul class="mm-contact-list">
            @if (Model.Email.Length > 0)
            {
                <li><span class="mm-contact-list__label">Email</span><a href="@("mailto:" + Model.Email)">@Model.Email</a></li>
            }
            @if (Model.PhoneDisplay.Length > 0)
            {
                <li>
                    <span class="mm-contact-list__label">Phone</span>
                    @if (Model.PhoneHref.Length > 0)
                    {
                        <a href="@("tel:" + Model.PhoneHref)">@Model.PhoneDisplay</a>
                    }
                    else
                    {
                        <span>@Model.PhoneDisplay</span>
                    }
                </li>
            }
            @if (Model.Address.Length > 0)
            {
                <li><span class="mm-contact-list__label">Address</span><span>@Model.Address</span></li>
            }
            @if (Model.FacebookUrl.Length > 0)
            {
                <li><span class="mm-contact-list__label">Facebook</span><a href="@Model.FacebookUrl" target="_blank" rel="noopener">@Model.FacebookUrl</a></li>
            }
            @if (Model.InstagramUrl.Length > 0)
            {
                <li><span class="mm-contact-list__label">Instagram</span><a href="@Model.InstagramUrl" target="_blank" rel="noopener">@Model.InstagramUrl</a></li>
            }
        </ul>
    }
    else
    {
        <p class="mm-empty">Contact details will be available soon.</p>
    }

    <div class="mm-actions">
        <a class="pill-btn pill-btn-primary" href="@Url.Action("Contact", "Home")">Contact us</a>
    </div>
</section>

</div>
