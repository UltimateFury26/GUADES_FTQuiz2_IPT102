@{
    // Shown (with a 404 status) for an unknown, invalid or unpublished product id.
    ViewBag.Title = "Product not found";
}

<div class="mm-notfound">
    <span class="mm-notfound__mark" aria-hidden="true">?</span>
    <span class="mm-eyebrow">Products</span>
    <h1 class="mm-page-head__title">Product not found</h1>
    <p class="mm-page-head__lead">That product doesn&rsquo;t exist or isn&rsquo;t available right now.</p>

    <div class="mm-actions">
        <a class="pill-btn pill-btn-primary" href="@Url.Action("Index", "FTQuiz2_Products")">See all products</a>
        <a class="pill-btn pill-btn-secondary" href="@Url.Content("~/")">Back to home</a>
    </div>
</div>
