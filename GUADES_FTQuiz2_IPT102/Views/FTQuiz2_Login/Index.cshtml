@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_LoginViewModel
@{
    // Mogu Mogu sign-in page (Auth layout shell). Class names and attributes are unchanged;
    // the password input keeps id "txtPassword".
    ViewBag.Title = "Log in";
    string focusId = ViewBag.FTQuiz2_FocusId as string;
}

<h1 class="auth-title">Log in</h1>
<p class="auth-sub">Use your username or email to enter the Mogu Mogu website.</p>

@Html.Partial("_FTQuiz2_Notices")

@using (Html.BeginForm("Index", "FTQuiz2_Login", new { ReturnUrl = Request.QueryString["ReturnUrl"] }, FormMethod.Post, new { @class = "auth-form" }))
{
    @Html.AntiForgeryToken()

    <div class="form-field">
        <label class="form-label" for="Identifier">Username or email</label>
        @Html.TextBoxFor(m => m.Identifier, new
        {
            @class = "form-input",
            maxlength = "100",
            autocomplete = "username",
            autocapitalize = "none",
            spellcheck = "false"
        })
        @Html.ValidationMessageFor(m => m.Identifier, "", new { @class = "form-error" })
    </div>

    <div class="form-field">
        <label class="form-label" for="txtPassword">Password</label>
        <div class="password-field">
            @Html.PasswordFor(m => m.Password, new
            {
                id = "txtPassword",
                @class = "form-input",
                maxlength = "100",
                autocomplete = "current-password"
            })
            <button type="button" class="password-toggle" aria-label="Show password">
                <svg class="icon icon-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                <svg class="icon icon-eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18" /><path d="M10.6 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C4 8.3 2 12 2 12s3.6 7 10 7c1.4 0 2.7-.3 3.9-.8" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
            </button>
        </div>
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "form-error" })
    </div>

    <button type="submit" class="pill-btn pill-btn-primary auth-submit">Log in</button>
}

<p class="auth-foot">
    New here? <a href="~/FTQuiz2_Signup">Create an account</a>
</p>

@section FTQuiz2_Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @if (!string.IsNullOrEmpty(focusId))
    {
        <script>
            (function () {
                var el = document.getElementById("@focusId");
                if (el) { el.focus(); }
            })();
        </script>
    }
}
