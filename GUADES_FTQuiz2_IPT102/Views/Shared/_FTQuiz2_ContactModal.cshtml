@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_ChromeViewModel

<!-- CONTACT MODAL (owner's details, from the database) -->
<div class="modal-overlay" id="contactModal">
    <div class="modal-box">
        <button type="button" class="modal-close" data-close>
            <svg class="icon" viewBox="0 0 24 24"><path d="M6 6l12 12" /><path d="M18 6 6 18" /></svg>
        </button>
        <h3>Contact</h3>
        @if (Model.Email.Length > 0)
        {
            <div class="contact-row">
                <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M4 7l8 6 8-6" /></svg>
                <a href="@("mailto:" + Model.Email)">@Model.Email</a>
            </div>
        }
        @if (Model.PhoneDisplay.Length > 0)
        {
            <div class="contact-row">
                <svg class="icon" viewBox="0 0 24 24"><path d="M15.5 16.5c-4-1-8-5-9-9l2.4-2a1 1 0 0 0 .3-1.1L8 1.8A1 1 0 0 0 7 1.2L4 2c-.8 6.5 5.3 12.6 11.8 12l.8-3a1 1 0 0 0-.6-1l-2.6-1.2a1 1 0 0 0-1.1.3l-2 2.4" /></svg>
                <span>@Model.PhoneDisplay</span>
            </div>
        }
        @if (Model.Address.Length > 0)
        {
            <div class="contact-row">
                <svg class="icon" viewBox="0 0 24 24"><path d="M12 22s7-7.2 7-12a7 7 0 1 0-14 0c0 4.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>
                <span>@Model.Address</span>
            </div>
        }
    </div>
</div>
