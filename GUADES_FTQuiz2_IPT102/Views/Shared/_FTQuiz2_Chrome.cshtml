@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_ChromeViewModel
@{
    // aria-current="page" on the active link (the attribute is omitted when the value is null).
    Func<string, string> current = cls => string.IsNullOrEmpty(cls) ? null : "page";
}

<!-- MOGU MOGU HEADER: brand, main navigation, Admin menu (admins only) and account menu -->
<header class="mm-header" id="mmHeader">
    <div class="mm-header__inner">

        <a class="mm-brand" href="@Url.Content("~/")" aria-label="Mogu Mogu - home">
            @Html.Partial("_FTQuiz2_BrandLogo")
        </a>

        <nav class="mm-nav" id="mmNav" aria-label="Primary">
            <a class="@("mm-nav__link" + Model.HomeActiveClass())" aria-current="@current(Model.HomeActiveClass())" href="@Url.Content("~/")">Home</a>
            <a class="@("mm-nav__link" + Model.ActiveClass("Home", "About"))" aria-current="@current(Model.ActiveClass("Home", "About"))" href="@Url.Action("About", "Home")">Our Story</a>
            <a class="@("mm-nav__link" + Model.ActiveClass("FTQuiz2_Products"))" aria-current="@current(Model.ActiveClass("FTQuiz2_Products"))" href="@Url.Action("Index", "FTQuiz2_Products")">Products</a>
            <a class="@("mm-nav__link" + Model.ActiveClass("Home", "Contact"))" aria-current="@current(Model.ActiveClass("Home", "Contact"))" href="@Url.Action("Contact", "Home")">Contact</a>
            <a class="@("mm-nav__link" + Model.ActiveClass("FTQuiz2_Business"))" aria-current="@current(Model.ActiveClass("FTQuiz2_Business"))" href="@Url.Action("Owners", "FTQuiz2_Business")">Owners / Company</a>

            @if (Model.IsAdmin)
            {
                <details class="mm-menu" id="adminMenu">
                    <summary class="mm-nav__link mm-menu__toggle">
                        Admin
                        <svg class="icon mm-menu__caret" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg>
                    </summary>
                    <div class="mm-menu__panel">
                        <a class="@("mm-menu__item" + Model.ActiveClass("FTQuiz2_ManageUsers"))" aria-current="@current(Model.ActiveClass("FTQuiz2_ManageUsers"))" href="@Url.Content("~/FTQuiz2_Admin/FTQuiz2_ManageUsers")">Users</a>
                        <a class="@("mm-menu__item" + Model.ActiveClass("FTQuiz2_ManageContent"))" aria-current="@current(Model.ActiveClass("FTQuiz2_ManageContent"))" href="@Url.Content("~/FTQuiz2_Admin/FTQuiz2_ManageContent")">Content</a>
                        <a class="@("mm-menu__item" + Model.ActiveClass("FTQuiz2_ManageProducts"))" aria-current="@current(Model.ActiveClass("FTQuiz2_ManageProducts"))" href="@Url.Content("~/FTQuiz2_Admin/FTQuiz2_ManageProducts")">Products</a>
                        <a class="@("mm-menu__item" + Model.ActiveClass("FTQuiz2_ManagePosts"))" aria-current="@current(Model.ActiveClass("FTQuiz2_ManagePosts"))" href="@Url.Content("~/FTQuiz2_Admin/FTQuiz2_ManagePosts")">Posts</a>
                        <a class="@("mm-menu__item" + Model.ActiveClass("FTQuiz2_Reports"))" aria-current="@current(Model.ActiveClass("FTQuiz2_Reports"))" href="@Url.Content("~/FTQuiz2_Admin/FTQuiz2_Reports")">Reports</a>
                    </div>
                </details>
            }
        </nav>

        <details class="account-menu" id="accountMenu">
            <summary class="account-toggle" aria-label="@("Account menu: " + Model.AccountName)">
                <span class="account-initial" aria-hidden="true">@Model.AccountInitial</span>
                <span class="account-name">@Model.AccountName</span>
            </summary>
            <div class="account-dropdown">
                <p class="account-role">Signed in as @Model.AccountName (@Model.AccountRole)</p>
                <a class="account-item" href="@Url.Content("~/FTQuiz2_MyAccount")">My Account</a>
                @* Sign-out stays a POST with an anti-forgery token so a GET (prefetch, crawler, <img>) cannot log anyone out. *@
                <form method="post" action="@Url.Content("~/FTQuiz2_Logout")" class="account-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="account-item">Log out</button>
                </form>
            </div>
        </details>

        <button type="button" class="mm-nav-toggle" id="mmNavToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mmNav">
            <svg class="icon" viewBox="0 0 24 24"><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></svg>
        </button>
    </div>
</header>
