@{
    // Port of Auth.Master: centered card on a plain background (Login, Signup, Error).
    // No database access here, so these pages still render when the database is down.
    string pageTitle = ViewBag.Title as string;
    string fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? "Portfolio" : pageTitle + " | Portfolio";
}
<!DOCTYPE html>

<html lang="en">
<head>
    <title>@fullTitle</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @Styles.Render("~/FTQuiz2_Content/css")
    @RenderSection("FTQuiz2_Head", required: false)
</head>
<body>
    <main class="auth-wrap">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="rail-logo auth-logo">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M4 11.5 12 4l8 7.5" /><path d="M6 10v9a1 1 0 0 0 1 1h3v-5h4v5h3a1 1 0 0 0 1-1v-9" /></svg>
                </div>
            </div>
            @RenderBody()
        </div>
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/FTQuiz2_Scripts/js")
    @RenderSection("FTQuiz2_Scripts", required: false)
</body>
</html>
