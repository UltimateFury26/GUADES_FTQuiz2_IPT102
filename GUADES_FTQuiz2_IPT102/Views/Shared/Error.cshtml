@{
    // Shown by HandleErrorAttribute for an unhandled exception inside an action. The layout is set here
    // on purpose: the normal site shell reads the database, and the database may be what failed.
    Layout = "~/Views/Shared/_FTQuiz2_AuthLayout.cshtml";
    ViewBag.Title = "Something went wrong";
}

<h1 class="auth-title">Something went wrong</h1>
<p class="auth-sub">
    We couldn't finish that request. Nothing you did caused it, so please try again in a moment.
</p>
<div class="auth-actions">
    <a class="pill-btn pill-btn-primary" href="~/">Back to Home</a>
</div>
