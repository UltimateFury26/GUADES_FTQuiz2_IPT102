@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Port of Site.Master: signed-in shell (icon rail, top bar, footer, Contact modal).
    FTQuiz2_ChromeViewModel chrome = FTQuiz2_ChromeViewModel.ForRequest();
    string pageTitle = ViewBag.Title as string;
    string fullTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? chrome.OwnerName + " | IT Portfolio"
        : pageTitle + " | " + chrome.OwnerName;
}
<!DOCTYPE html>

<html lang="en">
<head>
    <title>@fullTitle</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @Styles.Render("~/FTQuiz2_Content/css")
    @Styles.Render("~/FTQuiz2_Content/admin")
    @RenderSection("FTQuiz2_Head", required: false)
</head>
<body class="@(ViewBag.FTQuiz2_BodyClass as string)">
    @Html.Partial("_FTQuiz2_Chrome", chrome)

    <!-- MAIN BODY -->
    <main class="site-body">
        <div class="page-inner" id="top">

            @Html.Partial("_FTQuiz2_Notices")

            @RenderBody()

            <!-- FOOTER -->
            <footer class="site-footer">
                <p class="footer-copy">&copy; @DateTime.Now.Year @chrome.OwnerName. All rights reserved.</p>
                <div class="footer-socials">
                    @if (chrome.GitHubUrl.Length > 0)
                    {
                        <a href="@chrome.GitHubUrl" target="_blank" rel="noopener" class="footer-social-link">
                            <svg class="icon" viewBox="0 0 24 24"><path d="M9 18 3 12l6-6" /><path d="M15 6l6 6-6 6" /></svg>
                            GitHub
                        </a>
                    }
                    @if (chrome.LinkedInUrl.Length > 0)
                    {
                        <a href="@chrome.LinkedInUrl" target="_blank" rel="noopener" class="footer-social-link">
                            <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="12" rx="2" /><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><path d="M3 13h18" /></svg>
                            LinkedIn
                        </a>
                    }
                </div>
            </footer>

        </div>
    </main>

    @Html.Partial("_FTQuiz2_ContactModal", chrome)

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/FTQuiz2_Scripts/js")
    @RenderSection("FTQuiz2_Scripts", required: false)
</body>
</html>
