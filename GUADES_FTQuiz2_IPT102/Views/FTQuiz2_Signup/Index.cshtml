@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_SignupViewModel
@{
    // Port of Signup.aspx (Auth.Master shell comes from _ViewStart). The password input keeps
    // id "txtPassword" because the strength meter looks it up through data-strength-for.
    ViewBag.Title = "Sign up";
    string focusId = ViewBag.FTQuiz2_FocusId as string;
}

<div class="auth-page auth-page--signup">
<h1 class="auth-title">Create your account</h1>
<p class="auth-sub">Sign up to browse Mogu Mogu products and company information.</p>

@Html.Partial("_FTQuiz2_Notices")

@using (Html.BeginForm("Index", "FTQuiz2_Signup", FormMethod.Post, new { @class = "auth-form" }))
{
    @Html.AntiForgeryToken()

    <div class="form-field">
        <label class="form-label" for="Username">Username</label>
        @Html.TextBoxFor(m => m.Username, new
        {
            @class = "form-input",
            maxlength = "50",
            autocomplete = "username",
            autocapitalize = "none",
            spellcheck = "false"
        })
        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "form-error" })
    </div>

    <div class="form-field">
        <label class="form-label" for="Email">Email</label>
        @Html.TextBoxFor(m => m.Email, new
        {
            @class = "form-input",
            type = "email",
            maxlength = "100",
            autocomplete = "email",
            autocapitalize = "none",
            spellcheck = "false",
            data_rule_email = "false"   /* keep the source's own message, not jquery.validate's generic email one */
        })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "form-error" })
    </div>

    <div class="form-field">
        <label class="form-label" for="Phone">Phone number</label>
        @Html.TextBoxFor(m => m.Phone, new
        {
            @class = "form-input",
            type = "tel",
            maxlength = "11",
            autocomplete = "tel",
            inputmode = "numeric",
            placeholder = "09123456789"
        })
        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "form-error" })
    </div>

    <div class="form-field">
        <label class="form-label" for="txtPassword">Password</label>
        <div class="password-field">
            @Html.PasswordFor(m => m.Password, new
            {
                id = "txtPassword",
                @class = "form-input",
                maxlength = "100",
                autocomplete = "new-password"
            })
            <button type="button" class="password-toggle" aria-label="Show password">
                <svg class="icon icon-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                <svg class="icon icon-eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18" /><path d="M10.6 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C4 8.3 2 12 2 12s3.6 7 10 7c1.4 0 2.7-.3 3.9-.8" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
            </button>
        </div>
        <div class="pwd-strength" data-strength-for="txtPassword">
            <div class="pwd-strength-track"><div class="pwd-strength-fill" data-strength-fill></div></div>
            <span class="pwd-strength-label" data-strength-label></span>
        </div>
        <p class="form-hint">At least 8 characters, with a letter and a number.</p>
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "form-error" })
    </div>

    <div class="form-field">
        <label class="form-label" for="ConfirmPassword">Confirm password</label>
        <div class="password-field">
            @Html.PasswordFor(m => m.ConfirmPassword, new
            {
                @class = "form-input",
                maxlength = "100",
                autocomplete = "new-password"
            })
            <button type="button" class="password-toggle" aria-label="Show password">
                <svg class="icon icon-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg>
                <svg class="icon icon-eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18" /><path d="M10.6 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C4 8.3 2 12 2 12s3.6 7 10 7c1.4 0 2.7-.3 3.9-.8" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
            </button>
        </div>
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "form-error" })
    </div>

    <button type="submit" class="pill-btn pill-btn-primary auth-submit">Create account</button>
}

<p class="auth-foot">
    Already have an account? <a href="~/FTQuiz2_Login">Log in</a>
</p>
</div>

@section FTQuiz2_Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @if (!string.IsNullOrEmpty(focusId))
    {
        <script>
            (function () {
                var el = document.getElementById("@focusId");
                if (el) { el.focus(); }
            })();
        </script>
    }
}
