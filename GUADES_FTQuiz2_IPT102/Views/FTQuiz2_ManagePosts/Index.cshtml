@model GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels.FTQuiz2_ManagePostsViewModel
@using GUADES_FTQuiz2_IPT102.FTQuiz2_ViewModels
@{
    // Presentation-only refresh of the existing Manage Posts screen.
    // Sorting, routes, form names, POST actions, and anti-forgery protection are unchanged.
    ViewBag.Title = "Manage Posts";
    string listUrl = Url.Content("~/FTQuiz2_Admin/FTQuiz2_ManagePosts");
    string sortArg = Model.SortField;
    string dirArg = Model.SortField == null ? null : (Model.SortAsc ? "asc" : "desc");
    bool anyPosts = Model.Loaded && Model.Posts.Count > 0;

    string[][] columns =
    {
        new[] { "Announcement", "Title" },
        new[] { "Status", "IsPublished" },
        new[] { "Posted", "CreatedAt" },
        new[] { "Author", "AuthorName" }
    };
}

@Html.Partial("_FTQuiz2_AdminNav")

<section class="posts-page">
    <header class="admin-head posts-head">
        <div class="posts-head-copy">
            <h1 class="admin-title">Manage Posts</h1>
            <p class="admin-sub">Create and manage announcements for your community. Published posts appear on Home; drafts remain private.</p>
        </div>
        <div class="admin-head-actions posts-head-actions">
            <span class="admin-count">@Model.CountText</span>
            @if (!Model.ShowForm)
            {
                <a class="pill-btn pill-btn-primary posts-create-btn" href="@Url.Action("Index", new { add = "1", sort = sortArg, dir = dirArg })">
                    New announcement
                </a>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="@(Model.MessageKind == "success" ? "alert alert-success" : "alert alert-error") posts-feedback" role="alert">@Model.Message</div>
    }

    @if (Model.ShowForm)
    {
        <section class="posts-editor-panel" aria-labelledby="posts-editor-title">
            <div class="posts-panel-heading">
                <div>
                    <h2 id="posts-editor-title">@Model.FormTitle</h2>
                    <p>Write a clear update and choose whether it should be visible to visitors.</p>
                </div>
            </div>

            @using (Html.BeginForm("Save", "FTQuiz2_ManagePosts", FormMethod.Post, new { @class = "editor-card editor-form posts-form" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="PostId" value="@Model.Form.PostId" />
                <input type="hidden" name="sort" value="@sortArg" />
                <input type="hidden" name="dir" value="@dirArg" />

                <div class="form-field posts-field">
                    <label class="form-label" for="Title">Announcement title <span class="posts-required">Required</span></label>
                    @Html.TextBox("Title", Model.Form.Title, new { @class = "form-input", maxlength = 150, autofocus = "autofocus", placeholder = "e.g. New store hours this week" })
                    @Html.ValidationMessage("Title", "", new { @class = "form-error" })
                    <p class="form-hint">Use a short, descriptive title (up to 150 characters).</p>
                </div>

                <div class="form-field posts-field">
                    <label class="form-label" for="Body">Message <span class="posts-required">Required</span></label>
                    @Html.TextArea("Body", Model.Form.Body, 7, 20, new { @class = "form-input form-textarea posts-message-input", placeholder = "Share the details of your announcement..." })
                    @Html.ValidationMessage("Body", "", new { @class = "form-error" })
                    <p class="form-hint">Up to 4,000 characters. Line breaks are kept when the post is shown.</p>
                </div>

                <div class="posts-publish-option">
                    <div class="posts-publish-copy">
                        <strong>Publishing status</strong>
                        <span>Choose whether this announcement should appear on the public Home page.</span>
                    </div>
                    <label class="posts-publish-check" for="IsPublished">
                        @Html.CheckBox("IsPublished", Model.Form.IsPublished)
                        <span>Publish now</span>
                    </label>
                </div>
                <p class="form-hint posts-publish-hint">Leave this unchecked to save the announcement as a draft. You can publish it later from the list.</p>

                <div class="editor-actions posts-editor-actions">
                    <button type="submit" class="pill-btn pill-btn-primary">Save announcement</button>
                    <a class="pill-btn pill-btn-secondary" href="@Url.Action("Index", new { sort = sortArg, dir = dirArg })">Cancel</a>
                </div>
            }
        </section>
    }
    else if (anyPosts)
    {
        <section class="posts-list-panel" aria-label="Announcements list">
            <div class="posts-list-heading">
                <div>
                    <h2>All announcements</h2>
                    <p>Review publication status, update content, or manage visibility.</p>
                </div>
                <span class="posts-list-count">@Model.CountText</span>
            </div>
            <div class="table-scroll posts-table-scroll">
                <table class="data-table posts-table">
                    <thead>
                        <tr>
                            @foreach (string[] col in columns)
                            {
                                <th scope="col"><a class="posts-sort-link @Model.SortHeaderClass(col[1])" href="@(listUrl + "?sort=" + col[1] + "&dir=" + Model.NextDir(col[1]))">@Model.SortHeaderText(col[0], col[1])</a></th>
                            }
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model.Posts)
                        {
                            <tr>
                                <td class="cell-wrap posts-announcement-cell">
                                    <p class="post-title posts-row-title">@post.Title</p>
                                    <p class="post-preview posts-row-preview">@FTQuiz2_ManagePostsViewModel.Preview(post.Body)</p>
                                </td>
                                <td><span class="@Model.StatusBadgeClass(post.IsPublished) posts-status">@Model.StatusText(post.IsPublished)</span></td>
                                <td class="posts-date-cell">
                                    <span>@Model.FormatDateTime(post.CreatedAt)</span>
                                    @if (post.UpdatedAt.HasValue)
                                    {
                                        <p class="post-meta posts-updated-meta">Updated @Model.FormatDateTime(post.UpdatedAt.Value)</p>
                                    }
                                </td>
                                <td class="posts-author-cell">@post.AuthorName</td>
                                <td class="cell-actions posts-actions-cell">
                                    <div class="posts-action-group">
                                        <a class="row-btn posts-action-btn" href="@Url.Action("Index", new { edit = post.PostId, sort = sortArg, dir = dirArg })">Edit</a>

                                        @using (Html.BeginForm("SetPublished", "FTQuiz2_ManagePosts", FormMethod.Post, new { @class = "inline-form" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="postId" value="@post.PostId" />
                                            <input type="hidden" name="publish" value="@(post.IsPublished ? "false" : "true")" />
                                            <input type="hidden" name="sort" value="@sortArg" />
                                            <input type="hidden" name="dir" value="@dirArg" />
                                            <button type="submit" class="row-btn posts-action-btn">@(post.IsPublished ? "Unpublish" : "Publish")</button>
                                        }

                                        @using (Html.BeginForm("Delete", "FTQuiz2_ManagePosts", FormMethod.Post, new { @class = "inline-form" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="postId" value="@post.PostId" />
                                            <input type="hidden" name="sort" value="@sortArg" />
                                            <input type="hidden" name="dir" value="@dirArg" />
                                            <button type="submit" class="row-btn row-btn-danger posts-action-btn posts-delete-btn"
                                                    data-confirm="Delete &quot;@post.Title&quot;? This can't be undone."
                                                    onclick="return confirm(this.getAttribute('data-confirm'));">Delete</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="posts-table-note">Tip: Select a column heading to sort the announcement list.</p>
        </section>
    }
    else if (Model.Loaded)
    {
        <section class="posts-empty-state" aria-labelledby="posts-empty-title">
            <h2 id="posts-empty-title">No announcements yet</h2>
            <p>Keep your visitors informed by creating your first announcement. You can save it as a draft or publish it when it is ready.</p>
            <a class="pill-btn pill-btn-primary" href="@Url.Action("Index", new { add = "1", sort = sortArg, dir = dirArg })">Create your first announcement</a>
        </section>
    }
</section>
